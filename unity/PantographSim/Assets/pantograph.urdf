<?xml version="1.0" ?>
<robot name="five_bar_mechanism">

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.002"/>
    </inertial>
    
    <visual name="base_visual">
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.20 0.005"/>
      </geometry>
      <material name="light_gray">
        <color rgba="0.9 0.9 0.9 1.0"/>
      </material>
    </visual>
    
    <visual name="motor_left_gold">
      <origin xyz="0 0.04 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.04"/>
      </geometry>
      <material name="gold">
        <color rgba="0.8 0.6 0.2 1.0"/>
      </material>
    </visual>
    
    <visual name="motor_left_shaft">
      <origin xyz="0 0.04 0.055" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.005" length="0.02"/>
      </geometry>
      <material name="silver">
        <color rgba="0.75 0.75 0.75 1.0"/>
      </material>
    </visual>
    
    <visual name="motor_right_gold">
      <origin xyz="0 -0.04 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.04"/>
      </geometry>
      <material name="gold"/>
    </visual>
    
    <visual name="motor_right_shaft">
      <origin xyz="0 -0.04 0.055" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.005" length="0.02"/>
      </geometry>
      <material name="silver"/>
    </visual>
  </link>

  <link name="left_crank">
    <inertial>
      <origin xyz="0.04 0 0" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
    <visual name="visual_box">
      <origin xyz="0.04 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.025 0.002"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <visual name="visual_start_cap">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0125" length="0.002"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <visual name="visual_end_cap">
      <origin xyz="0.08 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0125" length="0.002"/>
      </geometry>
      <material name="silver"/>
    </visual>
  </link>

  <joint name="left_motor_joint" type="revolute">
    <parent link="base_link"/>
    <child link="left_crank"/>
    <origin xyz="0 0.04 0.056" rpy="0 0 1.04719"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" lower="-3.14" upper="3.14" velocity="10.0"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>

  <link name="left_arm">
    <inertial>
      <origin xyz="0.06 0 0" rpy="0 0 0"/>
      <mass value="0.04"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00008" iyz="0" izz="0.00008"/>
    </inertial>
    <visual name="visual_box">
      <origin xyz="0.06 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.025 0.002"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <visual name="visual_start_cap">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0125" length="0.002"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <visual name="visual_end_cap">
      <origin xyz="0.12 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0125" length="0.002"/>
      </geometry>
      <material name="silver"/>
    </visual>
  </link>

  <joint name="left_elbow_joint" type="revolute">
    <parent link="left_crank"/>
    <child link="left_arm"/>
    <origin xyz="0.08 0 0" rpy="0 0 -2.18819"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" lower="-3.14" upper="3.14" velocity="10.0"/>
    <dynamics damping="0.005" friction="0.005"/>
  </joint>

  <link name="end_effector_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
    <visual name="ee_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.012"/>
      </geometry>
      <material name="white">
        <color rgba="1.0 1.0 1.0 1.0"/>
      </material>
    </visual>
    <visual name="ee_pin_visual">
      <origin xyz="0 0 0.005" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.008"/>
      </geometry>
      <material name="light_gray"/>
    </visual>
  </link>

  <joint name="ee_left_joint" type="revolute">
    <parent link="left_arm"/>
    <child link="end_effector_link"/>
    <origin xyz="0.12 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" lower="-3.14" upper="3.14" velocity="10.0"/>
    <dynamics damping="0.001" friction="0.001"/>
  </joint>

  <link name="right_crank">
    <inertial>
      <origin xyz="0.04 0 0" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
    <visual name="visual_box">
      <origin xyz="0.04 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.025 0.002"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <visual name="visual_start_cap">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0125" length="0.002"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <visual name="visual_end_cap">
      <origin xyz="0.08 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0125" length="0.002"/>
      </geometry>
      <material name="silver"/>
    </visual>
  </link>

  <joint name="right_motor_joint" type="revolute">
    <parent link="base_link"/>
    <child link="right_crank"/>
    <origin xyz="0 -0.04 0.056" rpy="0 0 -1.04719"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" lower="-3.14" upper="3.14" velocity="10.0"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>

  <link name="right_arm">
    <inertial>
      <origin xyz="0.06 0 0" rpy="0 0 0"/>
      <mass value="0.04"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00008" iyz="0" izz="0.00008"/>
    </inertial>
    <visual name="visual_box">
      <origin xyz="0.06 0 -0.001" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.025 0.002"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <visual name="visual_start_cap">
      <origin xyz="0 0 -0.001" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0125" length="0.002"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <visual name="visual_end_cap">
      <origin xyz="0.12 0 -0.001" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0125" length="0.002"/>
      </geometry>
      <material name="silver"/>
    </visual>
  </link>

  <joint name="right_elbow_joint" type="revolute">
    <parent link="right_crank"/>
    <child link="right_arm"/>
    <origin xyz="0.08 0 0" rpy="0 0 2.18819"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" lower="-3.14" upper="3.14" velocity="10.0"/>
    <dynamics damping="0.005" friction="0.005"/>
  </joint>

</robot>